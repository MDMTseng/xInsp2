build/
**/build/
*.obj
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.vcxproj*
*.sln
node_modules/
.vscode-test/
out/
dist/
# Generated by the host on plugin certification
plugins/*/cert.json
sdk/examples/*/cert.json
# E2E screenshot artifacts
screenshot/
# Release build artifacts (produced by tools/build_release.mjs)
release/
vscode-extension/*.vsix
# Python bytecode caches
**/__pycache__/
*.pyc
# FL example driver / harness output artifacts (regenerated each run)
examples/*/driver_summary.json
examples/*/results.json
examples/*/_results_*.json
examples/*/driver_log.json
# FL agent progress telemetry (per memory: feedback_agent_progress_brief)
.fl_progress/

# FL run_all aggregator artifacts (regenerated each run)
examples/*/_run_all.log
examples/*/_run_all_summary.json

# Per-example backend stdout/stderr logs (regenerated each run). The ** forms
# cover examples with project subdirs (e.g. qa_result_order/{arrival,completion}/).
examples/*/backend.log
examples/*/backend.log.err
examples/**/backend*.log
examples/**/session*.log
examples/**/fe*.log
examples/**/be*.log
examples/**/gw.log
# Plugin UI test screenshots (regenerated each run by run_ui_test.mjs)
examples/**/tests/screenshots/
sdk/**/tests/screenshots/
# FE crash history + preserved dumps + status snapshot (regenerated each run)
examples/**/crash-history.jsonl
examples/**/crash-dumps/
examples/**/fe-status.json
examples/**/fe-status.json.tmp

# Transactional project working copies (BE scratch; regenerated on open).
.xinsp_work/
**/.xinsp_work/

# Compiled script DLLs + the OpenCV PCH cache (regenerated by compile_and_load).
**/script_build/

# Driver-generated build helper scripts (regenerated each run)
examples/**/_build*.bat

# Auto-generated C/C++ IntelliSense config (the backend writes these into a
# project's .vscode on open_project; c_cpp_properties.json embeds machine-specific
# absolute include paths, so it is per-machine and must not be committed).
examples/**/.vscode/c_cpp_properties.json
examples/**/.vscode/extensions.json
hmi/**/.vscode/c_cpp_properties.json
hmi/**/.vscode/extensions.json
hmi/**/backend*.log

# QA team loop scratch countdown
tmp/qa_countdown.txt

# heal-test runtime marker (qa_fault) — recreated each run
examples/**/.crashed_once.marker

# QA driver runtime logs (agent-named; not fixtures)
examples/qa_edge/qe_*.log
examples/**/_fe_cfg/

# object_count_puzzle generated artifacts (regenerate via generate_puzzle.py)
examples/object_count_puzzle/frames/
examples/object_count_puzzle/ground_truth.json
examples/object_count_puzzle/predictions.json
examples/object_count_puzzle/detections_overlay.png
examples/*/*.scratch.log

# FE heartbeat files (runtime)
examples/*/*.hb
examples/*/gw.log
