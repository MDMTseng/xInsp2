build/
**/build/
build-linux/
build-*/
**/build-linux/
build_plugins/
**/build_plugins/
*.obj
*.exe
*.dll
*.so
*.lib
*.pdb
*.ilk
*.exp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.vcxproj*
*.sln
node_modules/
.vscode-test/
out/
dist/
# Generated by the host on plugin certification
toolbox/*/cert.json
sdk/examples/*/cert.json
# G1/G2 subprocess-certify verdict (crashed/quarantined stamp), per-machine
toolbox/*/.xi_certify.json
sdk/examples/*/.xi_certify.json
# E2E screenshot artifacts
screenshot/
# Release build artifacts (produced by tools/build_release.mjs)
release/
vscode-extension/*.vsix
# Python bytecode caches
**/__pycache__/
*.pyc
# FL example driver / harness output artifacts (regenerated each run)
qa/*/driver_summary.json
qa/*/results.json
qa/*/_results_*.json
qa/*/driver_log.json
# Fuzz smoke per-run artifacts (tests/fuzz/run_smoke.py — regenerated each run)
tests/fuzz/_results_*.json
tests/fuzz/_run_smoke_summary.json
# FL agent progress telemetry (per memory: feedback_agent_progress_brief)
.fl_progress/

# FL run_all aggregator artifacts (regenerated each run)
qa/*/_run_all.log
qa/*/_run_all_summary.json

# Per-example backend stdout/stderr logs (regenerated each run). The ** forms
# cover examples with project subdirs (e.g. qa_result_order/{arrival,completion}/).
qa/*/backend.log
qa/*/backend.log.err
qa/**/backend*.log
toolbox/**/example/backend*.log
qa/**/session*.log
qa/**/fe*.log
qa/**/be*.log
qa/**/gw.log
# Plugin UI test screenshots (regenerated each run by run_ui_test.mjs)
qa/**/tests/screenshots/
sdk/**/tests/screenshots/
# FE crash history + preserved dumps + status snapshot (regenerated each run)
qa/**/crash-history.jsonl
qa/**/crash-dumps/
qa/**/fe-status.json
qa/**/fe-status.json.tmp

# Transactional project working copies (BE scratch; regenerated on open).
.xinsp_work/
**/.xinsp_work/

# Compiled script DLLs + the OpenCV PCH cache (regenerated by compile_and_load).
**/script_build/

# Driver-generated build helper scripts (regenerated each run)
qa/**/_build*.bat

# Auto-generated C/C++ IntelliSense config (the backend writes these into a
# project's .vscode on open_project; c_cpp_properties.json embeds machine-specific
# absolute include paths, so it is per-machine and must not be committed).
qa/**/.vscode/c_cpp_properties.json
qa/**/.vscode/extensions.json
hmi/**/.vscode/c_cpp_properties.json
hmi/**/.vscode/extensions.json
hmi/**/backend*.log

# QA team loop scratch countdown
tmp/qa_countdown.txt

# heal-test runtime marker (qa_fault) — recreated each run
qa/**/.crashed_once.marker

# QA driver runtime logs (agent-named; not fixtures)
qa/qa_edge/qe_*.log
qa/**/_fe_cfg/

# object_count_puzzle generated artifacts (regenerate via generate_puzzle.py)
examples/object_count_puzzle/frames/
examples/object_count_puzzle/ground_truth.json
examples/object_count_puzzle/predictions.json
examples/object_count_puzzle/detections_overlay.png
qa/*/*.scratch.log

# FE heartbeat files (runtime)
qa/*/*.hb
qa/*/gw.log

# plugin export packaging scratch (xinsp2 Export Project Plugin)
**/export_build/

# Agent worktrees (transient, must never be committed into the main repo)
.claude/worktrees/

# F5 advisory single-writer stamp (per-process, never committed)
.xinsp_owner

# qa_jpeg_preview phase2: driver copies the script into no_codec/ at run time
# (path-containment guard forbids the old "../inspect.cpp" reference)
qa/qa_jpeg_preview/no_codec/inspect.cpp

# qa_ui_egress phase2 (cap-absent) + phase3 (no-codec): driver copies the script
# into no_egress/ and no_codec/ at run time for the same path-containment reason.
qa/qa_ui_egress/no_egress/inspect.cpp
qa/qa_ui_egress/no_codec/inspect.cpp

# qa runtime artifacts (health snapshots + removed-instance residue)
qa/**/*.log.health
qa/qa_remove_under_load/instances/victim/
